    <a href="/rss.xml">RSS</a>
  </nav>
  <p>&copy; {currentYear} Paul Alvarez</p>
</footer>
<style>
  .site-footer { margin-top: 4rem; padding-bottom: 2rem; font-family: var(--font-sans); font-size: 0.8rem; color: var(--text-secondary); }
  nav { border-top: 1px solid var(--border-color); padding-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 1.25rem; margin-bottom: 1rem; }
