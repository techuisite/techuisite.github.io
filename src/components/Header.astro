---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<header class="site-header">
  <div class="container header-inner">
    <div class="brand">
      <a href="/" class="brand-title" aria-label="Alvalog"><span>Alva</span><span class="wordmark-log">log</span><span class="wordmark-dot" aria-hidden="true">.</span></a>
      <span class="brand-byline">By Paul Alvarez</span>
      <p class="brand-tagline">Technology, and how I live with it.</p>
    </div>

    <nav class="site-nav" aria-label="Main Navigation">
      <ul class="nav-links">
        <li><a href="/" class={currentPath === '/' ? 'active' : ''} aria-current={currentPath === '/' ? 'page' : undefined}>Home</a></li>
        <li><a href="/archive" class={currentPath === '/archive' ? 'active' : ''} aria-current={currentPath === '/archive' ? 'page' : undefined}>Archive</a></li>
        <li><a href="/about" class={currentPath === '/about' ? 'active' : ''} aria-current={currentPath === '/about' ? 'page' : undefined}>About</a></li>
        <li><a href="/rss.xml" class="rss-link" title="RSS Feed">RSS</a></li>
      </ul>
      <div class="theme-wrapper">
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header { padding: 3.5rem 0 2.5rem; margin-bottom: 2.5rem; }
  .header-inner { display: flex; flex-direction: column; gap: 1.4rem; }
  .brand { display: flex; align-items: baseline; flex-wrap: wrap; column-gap: 1rem; row-gap: 0.55rem; }
  .brand-title { font-family: var(--font-sans); font-size: 2.8rem; font-weight: 700; letter-spacing: -0.075em; color: var(--text-primary); text-decoration: none; line-height: 1.1; }
  .brand-byline { font-family: var(--font-sans); font-size: 0.8rem; color: var(--text-secondary); }
  .site-nav { display: flex; align-items: center; justify-content: space-between; width: 100%; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem; gap: 1rem; }
  .nav-links { display: flex; flex-wrap: wrap; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
  .nav-links li { margin: 0; }
  .nav-links a { font-family: var(--font-sans); font-size: 0.85rem; color: var(--text-secondary); text-decoration: none; }
  .nav-links a:hover, .nav-links a.active { color: var(--accent); text-decoration: underline; text-underline-offset: 5px; }
  .theme-wrapper { display: flex; }
  @media (max-width: 600px) { .site-header { padding-top: 2rem; margin-bottom: 1.5rem; } .brand-title { font-size: 2.4rem; } }
</style>

<style>
  .wordmark-log { font-weight: 400; }
  .wordmark-dot { color: var(--accent); }
  .brand-tagline { flex-basis: 100%; margin: 0; font-family: var(--font-serif); font-style: italic; font-size: 1.05rem; color: var(--text-secondary); }
  .site-nav { border-top: 3px solid var(--accent); border-bottom: 0; padding-top: 0.85rem; padding-bottom: 0; }
</style>
