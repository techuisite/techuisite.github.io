---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return sorted.map((post, index) => {
    const prevPost = index < sorted.length - 1 ? sorted[index + 1] : null;
    const nextPost = index > 0 ? sorted[index - 1] : null;

    return {
      params: { slug: post.id },
      props: { post, prevPost, nextPost },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);

function estimateReadingTime(body = '') {
  const words = body.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
  const minutes = Math.max(1, Math.round(words / 200));
  return `${minutes} min read`;
}

const formattedDate = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(post.data.pubDate);

const readingTime = estimateReadingTime(post.body);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
  article={true}
>
  <article class="article-container">
    <header class="article-header">
      <div class="article-meta">
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        <span class="meta-dot">&bull;</span>
        <span>{readingTime}</span>
        <span class="meta-dot">&bull;</span>
        <span>By Paul Alvarez</span>
      </div>

      <h1 class="article-title">{post.data.link ? <a href={post.data.link}>{post.data.title}<span aria-label=" (external link)"> ↗</span></a> : post.data.title}</h1>

    </header>

    {post.data.heroImage && (
      <div class="article-hero-wrap">
        <img
          src={post.data.heroImage}
          alt={post.data.title}
          class="article-hero-image"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    )}

    <div class="article-content prose">
      <Content />
    </div>

    <footer class="article-footer">
      <nav class="post-navigation" aria-label="Adjacent Articles">
        {prevPost ? (
          <a href={`/posts/${prevPost.id}`} class="nav-prev">
            <span class="nav-direction">&larr; Older</span>
            <span class="nav-title">{prevPost.data.title}</span>
          </a>
        ) : <div />}

        {nextPost ? (
          <a href={`/posts/${nextPost.id}`} class="nav-next">
            <span class="nav-direction">Newer &rarr;</span>
            <span class="nav-title">{nextPost.data.title}</span>
          </a>
        ) : <div />}
      </nav>

      <div class="back-home-wrap">
        <a href="/" class="back-home-link">&larr; Back to all articles</a>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .article-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .article-header {
    margin-bottom: 2.5rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    font-family: var(--font-sans);
  }

  .meta-dot {
    color: var(--border-color);
  }

  .article-title {
    font-size: clamp(1.7rem, 4vw, 2.1rem);
    line-height: 1.18;
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.02em;
  }

  .article-hero-wrap {
    margin: 2rem 0 3rem;
    border-radius: 2px;
    overflow: hidden;

  }

  .article-hero-image {
    width: 100%;
    height: auto;
    display: block;
    max-height: 540px;
    object-fit: cover;
  }

  .article-content {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .article-content :global(p) {
    margin-bottom: 1.75rem;
  }

  .article-content :global(h2) {
    font-size: 1.85rem;
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .article-content :global(h3) {
    font-size: 1.4rem;
    margin-top: 2.25rem;
    margin-bottom: 1rem;
  }

  .article-content :global(img:not(.kg-bookmark-thumbnail img)) {
    margin: 2.5rem auto;
    border-radius: 2px;

  }

  .article-content :global(.kg-bookmark-thumbnail img) {
    margin: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
  }

  .article-footer {
    margin-top: 4.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border-color);
  }

  .post-navigation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .nav-prev, .nav-next {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: 2px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .nav-next {
    text-align: right;
  }

  .nav-prev:hover, .nav-next:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .nav-direction {
    font-size: 0.8rem;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
  }

  .nav-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .back-home-wrap {
    text-align: center;
    margin-top: 2rem;
  }

  .back-home-link {
    font-weight: 600;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.95rem;
    transition: color 0.15s ease;
  }

  .back-home-link:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .article-title {
      font-size: 2.1rem;
    }

    .post-navigation {
      grid-template-columns: 1fr;
    }

    .nav-next {
      text-align: left;
    }
  }
</style>
