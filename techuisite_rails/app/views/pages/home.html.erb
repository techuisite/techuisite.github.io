<div class="terminal" data-controller="terminal">
  <div class="terminal-header">
    <span class="dot red"></span>
    <span class="dot yellow"></span>
    <span class="dot green"></span>
    <span class="terminal-title"></span>
  </div>
  <div class="terminal-body" data-terminal-target="body">
    <span class="prompt">$</span> Hello, welcome to my website!<br>
    <span class="prompt">$</span> Type <b>help</b> to get started.<br>
  </div>
  <input type="text" data-terminal-target="input" class="terminal-input" autofocus autocomplete="off" placeholder="Type a command...">
</div>
